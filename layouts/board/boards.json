{
    "version": "1.0.0",
    "layout_name": "board/boards",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "seo": {
            "enabled": true,
            "extensions": [
                { "type": "module", "id": "sirsoft-board" }
            ],
            "data_sources": ["boardList"],
            "page_type": "boards",
            "toggle_setting": "$module_settings:sirsoft-board:seo.seo_boards",
            "vars": {
                "site_name": "$core_settings:general.site_name"
            },
            "priority": 0.5,
            "changefreq": "weekly",
            "og": {
                "type": "website"
            },
            "structured_data": {
                "@type": "ItemList"
            }
        }
    },
    "data_sources": [
        {
            "id": "boardList",
            "comment": "limit=1: 게시판마다 최근 원글 1건(recent_posts[0].created_at)을 함께 받아 최근활동순 정렬에 쓴다(2026-09-26 2차). 서버가 답글·삭제·미게시 글을 빼고, 호출자가 읽을 수 있는 게시판만 준다. 카드에는 이 값을 표시하지 않는다.",
            "label_key": "$t:editor.data_source.boardList",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-board/boards",
            "method": "GET",
            "params": {
                "limit": 1
            },
            "auto_fetch": true,
            "auth_mode": "optional",
            "refetchOnMount": true,
            "errorHandling": {
                "403": {
                    "handler": "showErrorPage",
                    "params": {
                        "target": "content"
                    }
                }
            }
        }
    ],
    "slots": {
        "content": [
            {
                "type": "layout",
                "name": "Container",
                "props": {
                    "className": "py-8"
                },
                "responsive": {
                    "portable": {
                        "props": {
                            "className": "py-4"
                        }
                    }
                },
                "children": [
                    {
                        "comment": "페이지 헤더",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mb-6"
                        },
                        "responsive": {
                            "portable": {
                                "props": {
                                    "className": "mb-4"
                                }
                            }
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex items-center gap-2 mb-2"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "table-cells-large",
                                            "size": "xl",
                                            "className": "text-gray-900 dark:text-white"
                                        },
                                        "responsive": {
                                            "portable": {
                                                "props": {
                                                    "name": "table-cells-large",
                                                    "size": "lg",
                                                    "className": "text-gray-900 dark:text-white"
                                                }
                                            }
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "H1",
                                        "props": {
                                            "className": "text-2xl font-bold text-gray-900 dark:text-white"
                                        },
                                        "text": "$t:board.all_boards.title",
                                        "responsive": {
                                            "portable": {
                                                "props": {
                                                    "className": "text-xl font-bold text-gray-900 dark:text-white"
                                                }
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "text-gray-600 dark:text-gray-400"
                                },
                                "text": "$t:board.all_boards.description"
                            }
                        ]
                    },
                    {
                        "comment": "게시판 그리드",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "grid grid-cols-2 gap-4"
                        },
                        "responsive": {
                            "portable": {
                                "props": {
                                    "className": "grid grid-cols-1 gap-3"
                                }
                            }
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "comment": "최근활동순(2026-09-26 2차): 최근 원글 작성 시각 내림차순, 글 없는 게시판은 맨 뒤, 같은 시각은 게시판 id 내림차순. 원본 배열은 slice() 로 복사해 두고 정렬한다. 비교는 봇용 서버 렌더링(PHP 평가기)이 localeCompare 를 지원하지 않아 삼항(1/-1/0)으로 쓴다. 한계: 봇용 서버 렌더링은 이 정렬을 적용하지 못해 봇에게는 생성일순으로 나간다(2026-09-26 실측).",
                                "iteration": {
                                    "source": "{{(boardList.data ?? []).slice().sort((a, b) => ((b.recent_posts?.[0]?.created_at ?? '') > (a.recent_posts?.[0]?.created_at ?? '') ? 1 : ((b.recent_posts?.[0]?.created_at ?? '') < (a.recent_posts?.[0]?.created_at ?? '') ? -1 : (b.id - a.id))))}}",
                                    "item_var": "board",
                                    "index_var": "index"
                                },
                                "children": [
                                    {
                                        "partial": "partials/board/boards/_board_card.json"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "comment": "게시판이 없을 때",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{!boardList.data || boardList.data.length === 0}}",
                        "props": {
                            "className": "text-center py-12"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Icon",
                                "props": {
                                    "name": "inbox",
                                    "size": "3x",
                                    "className": "text-gray-400 dark:text-gray-500 mx-auto mb-4"
                                }
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "text-gray-500 dark:text-gray-400"
                                },
                                "text": "$t:board.all_boards.empty"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
