{
    "version": "1.0.0",
    "layout_name": "home",
    "permissions": [],
    "extends": "_user_base",
    "meta": {
        "description": "홈 본문은 g7-home-widgets 가 overlay 로 _user_base 의 main_content(slot: content)에 앞쪽 삽입(prepend_child)한다. 템플릿은 홈에 자기 블록·데이터소스를 두지 않는다(2026-09-26 — 옛 최근글·인기글·공지 티커 제거). main_content 노드는 _user_base 에 있으므로 여기서 지워도 주입 지점은 남는다.",
        "seo": {
            "enabled": true,
            "priority": 1.0,
            "changefreq": "daily",
            "og": {
                "type": "website"
            },
            "structured_data": {
                "@type": "WebSite",
                "name": "{{_global.site_name ?? ''}}",
                "url": "{{_global.site_url ?? ''}}"
            }
        }
    },
    "data_sources": [],
    "slots": {
        "content": []
    }
}
