{
  "meta": {
    "is_partial": true,
    "description": "게시판 요약 카드 (웹진형 — 썸네일 없이 제목+날짜+요약)"
  },
  "type": "basic",
  "name": "Div",
  "props": {
    "className": "block w-full text-left bg-white dark:bg-gray-800 rounded-xl pt-4 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md hover:border-primary-200 dark:hover:border-primary-800 transition-all"
  },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "props": { "className": "flex items-center justify-between mb-2 px-4" },
      "children": [
        {
          "type": "basic",
          "name": "Button",
          "props": { "className": "font-semibold text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 cursor-pointer" },
          "text": "{{item.name}}",
          "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/board/{{item.slug}}" } }]
        },
        { "type": "basic", "name": "Span", "props": { "className": "text-xs font-medium text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/30 px-2 py-1 rounded" }, "text": "{{item.posts_count | number}}" }
      ]
    },
    {
      "type": "basic",
      "name": "Div",
      "props": { "className": "px-4 pb-2" },
      "children": [
        {
          "type": "basic",
          "name": "Div",
          "if": "{{item.recent_posts && item.recent_posts.length > 0}}",
          "props": { "className": "space-y-3" },
          "iteration": { "source": "{{item.recent_posts ?? []}}", "item_var": "post" },
          "children": [
            {
              "type": "basic",
              "name": "Div",
              "props": { "className": "py-1.5" },
              "children": [
                {
                  "comment": "제목 줄: 배지 + 제목 + 날짜",
                  "type": "basic",
                  "name": "Div",
                  "props": { "className": "flex items-center justify-between gap-2 mb-1" },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Div",
                      "props": { "className": "flex items-center gap-2 flex-1 min-w-0" },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Span",
                          "if": "{{post.is_notice}}",
                          "props": { "className": "text-xs font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/30 px-1.5 py-0.5 rounded shrink-0" },
                          "text": "$t:board.notice"
                        },
                        {
                          "type": "basic",
                          "name": "Icon",
                          "if": "{{post.is_secret}}",
                          "props": { "name": "lock", "className": "w-3.5 h-3.5 text-gray-400 dark:text-gray-500 shrink-0" }
                        },
                        {
                          "type": "basic",
                          "name": "Button",
                          "props": { "className": "text-sm font-medium text-gray-900 dark:text-white text-left line-clamp-1 hover:text-primary-600 dark:hover:text-primary-400 cursor-pointer" },
                          "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/board/{{item.slug}}/{{post.id}}" } }],
                          "text": "{{post.title}}"
                        },
                        {
                          "type": "basic",
                          "name": "Span",
                          "if": "{{post.is_new}}",
                          "props": { "className": "px-1.5 py-0.5 text-xs bg-red-500 text-white rounded shrink-0" },
                          "text": "N"
                        }
                      ]
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": { "className": "text-xs text-gray-500 dark:text-gray-400 shrink-0", "title": "{{post.created_at ?? ''}}" },
                      "text": "{{post.created_at_formatted ?? ''}}"
                    }
                  ]
                },
                {
                  "comment": "요약 2~3줄 — 비밀글/블라인드는 content_preview가 빈 문자열이라 자동으로 아무것도 안 보임",
                  "type": "basic",
                  "name": "P",
                  "if": "{{post.content_preview}}",
                  "props": { "className": "text-sm text-gray-500 dark:text-gray-400 line-clamp-3" },
                  "text": "{{post.content_preview}}"
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "name": "Div",
          "if": "{{!item.recent_posts || item.recent_posts.length === 0}}",
          "props": { "className": "py-10 my-1 text-center text-sm text-gray-400 dark:text-gray-500" },
          "children": [
            { "type": "basic", "name": "Span", "text": "$t:home.no_posts" }
          ]
        }
      ]
    },
    {
      "comment": "=== 더보기 버튼 ===",
      "type": "basic",
      "name": "Button",
      "props": { "className": "w-full px-4 py-3 text-center text-sm font-medium text-primary-600 dark:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors cursor-pointer border-t border-gray-100 dark:border-gray-700" },
      "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/board/{{item.slug}}" } }],
      "children": [
        { "type": "basic", "name": "Span", "text": "$t:common.more" },
        { "type": "basic", "name": "Icon", "props": { "name": "arrow-right", "className": "w-4 h-4 inline-block ml-1" } }
      ]
    }
  ]
}
