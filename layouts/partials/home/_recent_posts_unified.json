{
  "meta": {
    "is_partial": true,
    "description": "전체 최근글(게시판 무관 통합) 위젯 — g7-home-widgets 애드온 API(/api/plugins/g7-home-widgets/recent-posts) 사용, sirsoft-board 코어 무패치"
  },
  "type": "basic",
  "name": "Div",
  "props": {
    "className": "bg-white dark:bg-gray-800 rounded-xl p-5 shadow-sm border border-gray-100 dark:border-gray-700 h-full flex flex-col"
  },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "props": { "className": "flex items-center justify-between mb-4" },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": { "className": "text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2" },
          "children": [
            { "type": "basic", "name": "Icon", "props": { "name": "clock", "className": "w-5 h-5 text-gray-500 dark:text-gray-400" } },
            { "type": "basic", "name": "Span", "text": "$t:home.recent_posts" }
          ]
        }
      ]
    },
    {
      "type": "basic",
      "name": "Div",
      "if": "{{recent_posts_unified.data && recent_posts_unified.data.length > 0}}",
      "props": { "className": "divide-y divide-gray-100 dark:divide-gray-700" },
      "children": [
        {
          "type": "basic",
          "name": "Div",
          "iteration": { "source": "{{recent_posts_unified.data ?? []}}", "item_var": "post" },
          "children": [
            {
              "type": "basic",
              "name": "Button",
              "props": { "className": "block w-full text-left py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 rounded-lg px-1 transition-colors cursor-pointer" },
              "actions": [{ "type": "click", "handler": "navigate", "params": { "path": "/board/{{post.board_slug}}/{{post.id}}" } }],
              "children": [
                {
                  "comment": "1줄: 제목",
                  "type": "basic",
                  "name": "Div",
                  "props": { "className": "flex items-center gap-1.5 mb-0.5" },
                  "children": [
                    { "type": "basic", "name": "Icon", "if": "{{post.is_secret}}", "props": { "name": "lock", "className": "w-3.5 h-3.5 text-gray-400 dark:text-gray-500 shrink-0" } },
                    { "type": "basic", "name": "Span", "props": { "className": "text-sm font-medium text-gray-900 dark:text-white line-clamp-1" }, "text": "{{post.title}}" },
                    { "type": "basic", "name": "Span", "if": "{{post.is_new}}", "props": { "className": "px-1.5 py-0.5 text-xs bg-red-500 text-white rounded shrink-0" }, "text": "N" }
                  ]
                },
                {
                  "comment": "2줄: 게시판명 · 카테고리 · 조회수",
                  "type": "basic",
                  "name": "Div",
                  "props": { "className": "flex items-center justify-between gap-2 text-xs text-gray-500 dark:text-gray-400" },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Div",
                      "props": { "className": "flex items-center gap-1.5 min-w-0 flex-1" },
                      "children": [
                        { "type": "basic", "name": "Span", "props": { "className": "text-primary-600 dark:text-primary-400 shrink-0" }, "text": "{{post.board_name}}" },
                        { "type": "basic", "name": "Span", "if": "{{post.category}}", "props": { "className": "text-gray-300 dark:text-gray-600 shrink-0" }, "text": "·" },
                        { "type": "basic", "name": "Span", "if": "{{post.category}}", "props": { "className": "truncate min-w-0" }, "text": "{{post.category}}" }
                      ]
                    },
                    {
                      "type": "basic",
                      "name": "Div",
                      "props": { "className": "flex items-center gap-3 shrink-0" },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Span",
                          "props": { "className": "inline-flex items-center gap-1" },
                          "children": [
                            { "type": "basic", "name": "Icon", "props": { "name": "eye", "className": "w-3 h-3" } },
                            { "type": "basic", "name": "Span", "text": "{{post.view_count ?? 0}}" }
                          ]
                        },
                        { "type": "basic", "name": "Span", "props": { "title": "{{post.created_at ?? ''}}" }, "text": "{{post.created_at_formatted ?? ''}}" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "basic",
      "name": "Div",
      "if": "{{!recent_posts_unified.data || recent_posts_unified.data.length === 0}}",
      "props": { "className": "text-center py-8 text-gray-500 dark:text-gray-400 flex-grow flex flex-col items-center justify-center" },
      "children": [
        { "type": "basic", "name": "Icon", "props": { "name": "inbox", "className": "w-8 h-8 mx-auto mb-2 opacity-50" } },
        { "type": "basic", "name": "P", "props": { "className": "text-sm" }, "text": "$t:home.no_posts" }
      ]
    }
  ]
}
